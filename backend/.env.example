# Copy this file to .env and fill in your values.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used for OCR-text -> structured JSON parsing
GEMINI_PARSE_MODEL=gemini-3.5-flash

# Gemini model used to phrase the generated mock paper (Phase 04).
# Free tier: 3.1 Pro has no free quota — use gemini-3.5-flash; switch to
# gemini-3.1-pro-preview if the key has billing enabled.
GEMINI_GENERATE_MODEL=gemini-3.5-flash

# Embeddings (Phase 03 analysis engine)
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
# Cosine similarity above which two questions count as the same (semantic dedup)
DEDUP_THRESHOLD=0.85
# Per-year decay for recency weighting: weight = decay^(latest_year - year)
RECENCY_DECAY=0.85

# Pattern engine (Phase 04)
# A question slot enters the paper blueprint if present in this share of years
SLOT_MIN_SHARE=0.6
# Max "High Probability Surprise" candidates appended (Mode 2)
SURPRISE_COUNT=3
STUDY_GUIDE_SIZE=10

# SQLite by default (Phase 02). Switch to Postgres for Phase 03 (pgvector), e.g.:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/exam_analyzer
DATABASE_URL=sqlite:///./exam_analyzer.db

# Where uploaded papers are stored on disk
STORAGE_DIR=./storage/papers
